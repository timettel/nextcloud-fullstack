#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 1 || $# -gt 2 ]]; then
    echo "Usage: $0 PIGGYBACK_SOURCE [CLUSTER_NAME]" >&2
    exit 2
fi

if [[ -z "${OMD_ROOT:-}" || -z "${OMD_SITE:-}" ]]; then
    echo "Run this script as a Checkmk site user." >&2
    exit 2
fi

source_host=$1
cluster_name=${2:-$source_host}
piggyback_dir="${OMD_ROOT}/tmp/check_mk/piggyback"
config_file="${OMD_ROOT}/etc/check_mk/conf.d/kubernetes_${source_host}_piggyback.mk"
state_dir="${OMD_ROOT}/var/check_mk/kubernetes-piggyback-sync"
state_file="${state_dir}/${source_host}.hosts"
lock_file="${state_dir}/${source_host}.lock"

mkdir -p "${state_dir}"
exec 9>"${lock_file}"
flock -n 9 || exit 0

cmk --cleanup-piggyback >/dev/null

mapfile -t hosts < <(
    find "${piggyback_dir}" -mindepth 2 -maxdepth 2 -type f -name "${source_host}" \
        -printf '%h\n' 2>/dev/null \
        | sed 's#^.*/##' \
        | LC_ALL=C sort -u
)

for host in "${hosts[@]}"; do
    if [[ ! "${host}" =~ ^[A-Za-z0-9_.-]+$ ]]; then
        echo "Ignoring invalid piggyback host name: ${host}" >&2
        exit 1
    fi
done

tmp_config=$(mktemp "${config_file}.XXXXXX")
tmp_state=$(mktemp "${state_file}.XXXXXX")
trap 'rm -f "${tmp_config}" "${tmp_state}"' EXIT

{
    echo "# Generated by checkmk-raw-piggyback-sync. Do not edit."
    echo
    echo "all_hosts += ["
    for host in "${hosts[@]}"; do
        printf "    '%s',\n" "${host}"
    done
    echo "]"
    echo
    echo "host_tags.update({"
    for host in "${hosts[@]}"; do
        printf "    '%s': {'site': '%s', 'address_family': 'no-ip', 'agent': 'no-agent', 'piggyback': 'auto-piggyback', 'snmp_ds': 'no-snmp', 'criticality': 'test', 'networking': 'lan'},\n" \
            "${host}" "${OMD_SITE}"
    done
    echo "})"
    echo
    echo "host_labels.update({"
    for host in "${hosts[@]}"; do
        printf "    '%s': {'cmk/kubernetes/cluster': '%s'},\n" "${host}" "${cluster_name}"
    done
    echo "})"
} >"${tmp_config}"

printf '%s\n' "${hosts[@]}" >"${tmp_state}"

if [[ -f "${config_file}" ]] && cmp -s "${tmp_config}" "${config_file}"; then
    exit 0
fi

mapfile -t previous_hosts < <(
    if [[ -f "${state_file}" ]]; then
        LC_ALL=C sort -u "${state_file}"
    fi
)
mapfile -t new_hosts < <(
    comm -13 \
        <(printf '%s\n' "${previous_hosts[@]}" | sed '/^$/d' | LC_ALL=C sort -u) \
        <(printf '%s\n' "${hosts[@]}" | sed '/^$/d' | LC_ALL=C sort -u)
)

install -m 660 "${tmp_config}" "${config_file}"
install -m 660 "${tmp_state}" "${state_file}"

if ((${#new_hosts[@]})); then
    cmk -II "${new_hosts[@]}"
fi

cmk -O

